        "02_比赛启动/ai_usage_log.template.jsonl",
        "02_比赛启动/team_constraints.template.md"
      ],
      "add_at_runtime": [
        "当届官网规则与 AI 条款",
        "新题面、全部附件和空白提交模板",
        "队伍约束与分工"
      ],
      "exclude": [
        "03_A题_独立成果/**",
        "04_B题_独立成果/**",
        "05_官方范例对比/**",
        "07_文档成品/**"
      ],
      "notes": "这是最稳妥的赛时首批上传配置，避免答案类材料影响独立求解。"
