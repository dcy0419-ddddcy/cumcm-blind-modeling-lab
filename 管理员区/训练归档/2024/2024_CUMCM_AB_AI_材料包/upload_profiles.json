        "03_A题_独立成果/**",
        "04_B题_独立成果/**",
        "05_官方范例对比/**",
        "06_审计/**",
        "07_文档成品/**"
      ],
      "exclude": [
        "00_原始材料/**"
      ],
      "notes": "原题和空白模板仅在需要复现实验时另行加入；官方范例原文未再分发。"
    },
    {
      "id": "competition_start_minimal",
      "purpose": "新比赛开始后的通用方法启动",
      "include": [
