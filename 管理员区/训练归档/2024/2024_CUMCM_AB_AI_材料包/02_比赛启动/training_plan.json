      "required_tasks": [
        "完成原始输入到图表的全链路数据血缘。",
        "为每个常量记录来源定位、单位、类型与范围。",
        "用手算、解析式或小规模穷举复核至少两个核心结果。",
        "至少一张论文表由结构化结果自动生成。"
      ],
      "review_gate": {
        "prior_due_action_closure_percent_min": 80,
        "critical_open_max": 0,
        "unassigned_open_issues_max": 0,
        "regression_items_added_min": 1,
        "extra_conditions": [
          "完整题六项交付齐全。",
          "零值、极端值、缺失值和索引端点均有测试。"
        ]
      }
    },
    {
      "week": 3,
      "theme": "连续模型、求根、误差与收敛",
      "focused_person_hours": {
        "minimum": 10,
        "maximum": 13
      },
      "problem_volume": {
        "full_problem_runs": 1,
        "micro_drills": 2
      },
      "clean_reproduction": {
        "planned_attempts": 4,
        "minimum_passes": 3,
        "derived_rate_percent": 75,
