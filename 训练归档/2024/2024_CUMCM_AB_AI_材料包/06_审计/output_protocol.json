  "assumptions": [
    {
      "id": "assumption-a-fixed-tangency",
      "question_ids": [
        "A4"
      ],
      "kind": "interpretation",
      "statement": "调头曲线两端连接点与切向方向按题面给定约束固定。",
      "status": "accepted_by_team",
      "rationale": "固定端点和切向后，两圆弧半径与圆心角由几何条件唯一确定。",
      "impact": "2:1 半径分配不能再通过移动切点缩短；若允许移动切点则是另一个问题。",
      "source_ids": [
        "source-problem-a"
      ],
      "alternatives": [
        "将切点作为变量，并明确新的可行域后重新优化。"
      ],
      "sensitivity_validation_ids": [
        "validation-a-tests"
      ],
      "owner": "team-modeler"
    },
    {
      "id": "assumption-b-q2-restricted-actions",
      "question_ids": [
        "B2"
      ],
      "kind": "scope",
      "statement": "仅用四位首次决策编码即可覆盖问题 2 在完整题意下的全部返工动作空间。",
      "status": "rejected",
      "rationale": "冻结程序没有表达拆解后的自适应检测与重装动作；赛后官方讲评语义表明返工阶段允许重新选择动作。",
      "impact": "情形 1、3、5 的冻结策略并非官方语义下全局最优；情形 2、4、6 一致。",
      "source_ids": [
        "source-problem-b",
        "source-official-b"
      ],
      "alternatives": [
        "使用首次动作、拆解决策、返工状态动作组成的信息状态 MDP 或吸收链。"
