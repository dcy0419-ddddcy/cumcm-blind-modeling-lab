          "minimum": 50,
          "maximum": 65
        },
        "branch_coverage_policy": "reference_not_standalone_gate"
      },
      "writing": {
        "baseline_sessions": 0,
        "session_minutes": null,
        "speed_ratio_to_week1_B": {
          "minimum": 0.9,
          "maximum": 1.1
        },
        "rework_constraint": "investigate_if_above_week1_baseline"
