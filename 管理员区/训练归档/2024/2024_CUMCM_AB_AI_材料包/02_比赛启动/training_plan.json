{
  "plan_version": "1.0.0",
  "title": "八周数学建模全流程训练计划",
  "duration_weeks": 8,
  "target_focused_person_hours": {
    "minimum": 92,
    "maximum": 116,
    "unit": "focused_person_hour",
    "derivation": "八个周目标区间逐周相加；不是获奖所需时长估计。"
  },
  "planned_volume": {
    "full_problem_runs": 7,
    "micro_drills": 17
  },
  "calibration_policy": {
    "baseline_week": 1,
    "adjustable_after_baseline": [
      "weekly_hour_range",
      "writing_speed_ratio_range",
      "branch_coverage_reference_range"
    ],
    "not_adjustable_downward": [
      "critical_issue_gate",
      "clean_reproduction_success_definition",
      "final_critical_requirement_coverage",
      "no_fabrication_no_plagiarism_ai_rule_checks"
    ],
    "change_record_required": true,
    "note": "目标是训练管理阈值，不代表统计上精确的获奖预测。"
  },
  "metric_definitions": {
    "focused_person_hour": "有开始结束时间、任务和产物路径的专注人时；并行两人一小时计两人时，等待程序和无记录浏览不计。",
    "full_problem_run": "同一题完成题意契约、主模型、可运行代码、核心结果、验证报告和不少于六页核心稿。",
    "micro_drill": "45至120分钟的单技能训练，保留输入、产物和复盘；只改格式不重复计数。",
    "clean_reproduction": "在新输出目录用单一入口从原始输入生成必需产物，无手工改中间文件；退出码为零；确定性字段哈希一致，随机字段在预登记统计容差内。",
    "clean_reproduction_rate": "successful_clean_reproductions / planned_clean_reproductions；优先保存整数分子分母，百分比只是派生值。",
    "critical_requirement_coverage": "validated_critical_requirements / identified_critical_requirements；证据必须是测试、解析证明、人工双核或模板检查且路径存在。",
    "branch_coverage": "覆盖工具对本队代码测得的执行分支比例；第三方、生成和纯展示代码可排除但必须列清单。不支持测量时记录 not_measured。",
    "writing_baseline_B": "第一周两次45分钟限时写作的核验后保留中文字符数除以专注小时；公式源码、表格和参考文献不计。",
    "writing_speed_ratio": "current_verified_chinese_characters_per_hour / writing_baseline_B。",
    "factual_rework_rate": "因事实、公式、单位、来源或数表错误而删除或实质改写的字符 / 初稿字符。",
    "prior_action_closure_rate": "本周关闭的到期复盘动作 / 本周到期复盘动作；没有到期动作时记 not_applicable。"
  },
  "gate_policy": {
    "advance_only_on_pass": true,
    "remediation_hours": {
      "minimum": 2,
      "maximum": 4
    },
    "critical_open_max": 0,
    "unassigned_open_issues_max": 0,
    "prior_due_action_closure_percent_min": 80,
    "regression_item_added_per_week_min": 1,
    "overload_trigger": "连续两周超过周最高工时仍未通过时，缩小题量并分析拆分；不降低质量与诚信闸门。"
  },
  "weeks": [
    {
      "week": 1,
      "theme": "工具链、规则核验、输入契约与基线",
      "focused_person_hours": {
        "minimum": 8,
        "maximum": 10
      },
      "problem_volume": {
        "full_problem_runs": 0,
        "micro_drills": 3
      },
      "clean_reproduction": {
        "planned_attempts": 2,
        "minimum_passes": 1,
        "derived_rate_percent": 50,
        "consecutive_required": false
      },
      "test_coverage": {
        "critical_requirement_percent_min": 60,
        "branch_coverage_reference_percent": null,
        "branch_coverage_policy": "measure_baseline"
      },
      "writing": {
        "baseline_sessions": 2,
        "session_minutes": 45,
        "speed_ratio_to_week1_B": {
          "minimum": 1,
          "maximum": 1
        },
        "rework_constraint": "record_baseline"
      },
      "required_tasks": [
        "只用历史题面、数据和空白模板演练规则状态提取；未知条款标记 unverified。",
        "建立输入哈希、符号表、假设表、单入口和最小测试框架。",
        "完成单位索引审计、手算黄金样例、模板尺寸与数值类型三个微型题。",
        "将至少一个失败固化为回归测试。"
      ],
      "review_gate": {
        "prior_due_action_closure_percent_min": null,
        "critical_open_max": 0,
        "unassigned_open_issues_max": 0,
        "regression_items_added_min": 1,
        "extra_conditions": [
          "两次写作基线均保留初稿与次日核验版本。",
          "三个微型题都有输入与证据路径。"
        ]
      }
    },
    {
      "week": 2,
      "theme": "数据血缘、索引单位与解析小模型",
      "focused_person_hours": {
        "minimum": 10,
        "maximum": 12
      },
      "problem_volume": {
        "full_problem_runs": 1,
        "micro_drills": 2
      },
      "clean_reproduction": {
        "planned_attempts": 3,
