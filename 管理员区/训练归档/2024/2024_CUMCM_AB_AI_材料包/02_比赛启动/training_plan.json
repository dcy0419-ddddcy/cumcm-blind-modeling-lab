        "用不同实现或高精度差分复算一个核心轨迹或导数。",
        "微型题覆盖根分支跳跃及边界接触或端点根。"
      ],
      "review_gate": {
        "prior_due_action_closure_percent_min": 80,
        "critical_open_max": 0,
        "unassigned_open_issues_max": 0,
        "regression_items_added_min": 1,
        "extra_conditions": [
          "独立复算证据存在。",
          "非有限数未被静默替换。"
        ]
      }
    },
    {
      "week": 4,
      "theme": "优化、穷举基线与可行性证书",
      "focused_person_hours": {
        "minimum": 11,
        "maximum": 14
      },
      "problem_volume": {
        "full_problem_runs": 1,
